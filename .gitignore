node_modules/
.env
.env.*
!.env.example
*.log
.DS_Store
apps/engine/data/pro-drafts.sqlite

# Artefactos de sesiones Codex (no forman parte del repo)
.codex/

# Fase 9 — harness de evaluación (ADR-003).
# eval/reports/ es salida legible de cada corrida, no se versiona (salvo el .gitkeep).
# eval/baselines/ (v6-measured.json, split.json) y data/generated/ (+ data/metadata/) SÍ se versionan:
# son el candado de regresión y su procedencia.
eval/reports/*
!eval/reports/.gitkeep

# R0 Task 34 (Req 2B.3 c1/c2): S1 = snapshot de meta CONGELADO para evaluación. Se versiona con
# git NORMAL (~1–2 MB, sin Git LFS). Excepción ACOTADA: cualquier otro .sqlite / WAL / SHM bajo
# eval/snapshots/ (temporales del builder) queda ignorado; SÓLO S1.sqlite se trackea. No se
# des-ignora *.sqlite en general (eso vive en apps/engine/.gitignore, sin cambios).
eval/snapshots/*.sqlite
eval/snapshots/*.sqlite-wal
eval/snapshots/*.sqlite-shm
!eval/snapshots/S1.sqlite

# Certification remediation (Phase A, A1): frozen EMPIRICAL snapshots for Wave 5 certification packets (meta tables only,
# no accounts/pools -- see scripts/eval/freeze-empirical-snapshot.ts). Immutable; each carries a `<id>.provenance.json`.
!eval/snapshots/W5-EMP-*.sqlite

# TSK-217: artefactos del E2E (copia de la base, cookie sellada, trazas)
e2e/.tmp/
test-results/
playwright-report/
artifacts/qa/latest/
.qa-auth/
artifacts/qa/staging/
.next-e2e/

# R1 S7 (final blocker repair, Blocker 3): salida RUNTIME de "bun run verify:r1" -- nunca debe
# ensuciar un árbol limpio sólo por generar su propio reporte. docs/r1/certification-report.{json,md}
# (sin este prefijo) siguen trackeados como snapshot histórico/documentación de la ola que construyó
# este programa -- ya no son el destino de escritura de cada corrida.
docs/r1/generated/

# Bytecode de Python generado por los hooks de scripts/hooks/ (nunca se versiona)
__pycache__/
*.pyc

# STRATZ raw snapshots (unresolved commercial/redistribution permissions)
data/raw/
*.stratz-raw.json

# Live Dota capture (bun run dev:live): per-run session id + capture token for the local Overwolf
# capturer, and the runner's log. Never committed, never sent anywhere but 127.0.0.1.
.local/
scripts/live/overwolf-capture/local/
