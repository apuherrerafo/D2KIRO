# apps/engine: opcional; si falta, el motor usa el puerto 4000.
ENGINE_PORT=

# apps/engine: fijar en Railway para evitar un token distinto en cada redeploy.
CAPTURE_TOKEN=

# apps/engine: ruta del archivo SQLite que usa Drizzle.
ENGINE_DB_PATH=

# apps/web: server-only, nunca NEXT_PUBLIC_; usado por rewrites y /healthz hacia el motor.
ENGINE_INTERNAL_URL=

# apps/web: default true si falta; en false apaga /draft para siempre en esa instancia.
DRAFT_LIVE_ENABLED=

# apps/web: clave de cifrado de la cookie d2k_session (mínimo 32 caracteres).
SESSION_SECRET=

# apps/web y apps/engine: firma los tokens internos de cuenta (mínimo 32 caracteres).
INTERNAL_AUTH_SECRET=

# apps/web: origen público usado por el callback Steam OpenID.
PUBLIC_BASE_URL=

# apps/web: opcional; unica NEXT_PUBLIC_, default ws://127.0.0.1:4000/ws/draft para draft local.
NEXT_PUBLIC_ENGINE_WS_URL=

# SOLO desarrollo: token de Context7 (MCP de documentacion de libreria al dia, ver
# .claude/rules/context7.md). No se usa en runtime ni en el camino caliente. Debe estar
# exportado en el shell que lanza `claude` para que .mcp.json lo tome; sin el, el MCP corre
# en modo anonimo. Regenerar con `npx ctx7 login`.
CONTEXT7_API_KEY=
