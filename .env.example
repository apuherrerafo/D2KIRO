# apps/engine: opcional; si falta, el motor usa el puerto 4000.
ENGINE_PORT=

# apps/engine: fijar en Railway para evitar un token distinto en cada redeploy.
CAPTURE_TOKEN=

# apps/engine: ruta del archivo SQLite que usa Drizzle.
ENGINE_DB_PATH=

# apps/web: obligatorio en Railway; debe ser exactamente http://127.0.0.1:4000.
ENGINE_INTERNAL_URL=

# apps/web: obligatorio en Railway; debe ser exactamente false durante la beta privada.
DRAFT_LIVE_ENABLED=

# apps/web: clave de cifrado de la cookie d2k_session (mínimo 32 caracteres).
SESSION_SECRET=

# apps/web y apps/engine: firma los tokens internos de cuenta (mínimo 32 caracteres).
INTERNAL_AUTH_SECRET=

# apps/web: origen público usado por el callback Steam OpenID.
PUBLIC_BASE_URL=

# apps/web: opcional; unica NEXT_PUBLIC_, default ws://127.0.0.1:4000/ws/draft para draft local.
NEXT_PUBLIC_ENGINE_WS_URL=

# SOLO desarrollo: token de Context7 (MCP de documentacion de libreria al dia, ver
# .claude/rules/context7.md). No se usa en runtime ni en el camino caliente. Debe estar
# exportado en el shell que lanza `claude` para que .mcp.json lo tome; sin el, el MCP corre
# en modo anonimo. Regenerar con `npx ctx7 login`.
CONTEXT7_API_KEY=

# apps/web: OPCIONAL. Nombre y avatar de Steam: con esta clave se usa la Steam Web API (lib/steam-profile.ts); sin ella
# (o si falla) se lee el perfil publico de la comunidad de Steam, que no necesita clave. Si ninguno responde, el login sigue
# funcionando y la cuenta se muestra como "Jugador de Steam" (perfil no disponible). Es un secreto: solo en variables del
# servicio, nunca en el repo.
STEAM_WEB_API_KEY=

# apps/web: lista privada obligatoria de Steam32 permitidos. Separar por comas; ausencia, lista
# vacía o valor malformado bloquean el arranque. No usar NEXT_PUBLIC_: nunca se expone al navegador.
BETA_ALLOWED_STEAM_IDS=

# apps/web: administradores de la beta (Steam32, separados por comas). Solo ellos ven "Invitar amigos" y aprueban solicitudes.
# Vacio o mal formado = nadie administra. Un invitado aprobado NUNCA pasa a ser administrador.
BETA_ADMIN_STEAM_IDS=

# apps/web: OPCIONAL. Archivo con las invitaciones aprobadas desde la web. Por defecto, beta-access.json dentro del volumen
# persistente de Railway (RAILWAY_VOLUME_MOUNT_PATH), junto a la SQLite del motor.
BETA_ACCESS_FILE=

# apps/web: OPCIONAL. Archivo de mensajes de feedback de la beta (campanita y bandeja del administrador). Por defecto, feedback.json
# dentro del volumen persistente, junto a beta-access.json. Separado de los datos estratégicos de V6 (SQLite del motor).
FEEDBACK_FILE=

# apps/web: capturas del feedback en almacenamiento S3-compatible PRIVADO (recomendado: Cloudflare R2). Sin estas cuatro variables el feedback
# de texto funciona y la subida de imágenes queda desactivada (se le dice a la persona). Son secretos: solo en variables del servicio.
# Endpoint R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com ; región «auto». El bucket NO debe tener acceso público ni dominio público.
FEEDBACK_S3_ENDPOINT=
FEEDBACK_S3_BUCKET=
FEEDBACK_S3_ACCESS_KEY_ID=
FEEDBACK_S3_SECRET_ACCESS_KEY=
FEEDBACK_S3_REGION=
