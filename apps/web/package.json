  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev --config-dir .storybook --port 6006 --no-open",
    "storybook:build": "storybook build --config-dir .storybook --output-dir storybook-static",
    "catalog:generate": "bun run design/discovery/generate.ts",
