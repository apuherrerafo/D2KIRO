{
  "manifest_version": 1,
  "type": "WebApp",
  "meta": {
    "name": "D2KIRO Live Capture",
    "version": "0.1.0",
    "minimum-overwolf-version": "0.200.0",
    "author": "D2KIRO",
    "name_in_taskbar": "D2KIRO Live Capture",
    "description": "Captura local del draft de Dota 2 (Overwolf GEP) hacia el motor D2KIRO en 127.0.0.1. Sin lectura de memoria, sin OCR, sin modificar el cliente.",
    "icon": "icon.png",
    "icon_gray": "icon.png",
    "launcher_icon": "icon.png"
  },
  "permissions": ["GameInfo"],
  "data": {
    "game_targeting": {
      "type": "dedicated",
      "game_ids": [7314]
    },
    "game_events": [7314],
    "windows": {
      "background": {
        "file": "background.html",
        "is_background_page": true,
        "background_optimization": false
      }
    },
    "start_window": "background",
    "launch_events": [
      {
        "event": "GameLaunch",
        "event_data": { "game_ids": [7314] },
        "start_minimized": true
      }
    ]
  }
}
