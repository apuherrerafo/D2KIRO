{
  "enabledPlugins": {
    "caveman@caveman": false,
    "claude-code-setup@claude-plugins-official": false,
    "codex@openai-codex": false,
    "figma@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": true,
    "subastop-core@subastop-ai": false,
    "subastop-design@subastop-ai": false,
    "subastop-thinkers@subastop-ai": false,
    "superpowers@claude-plugins-official": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/pretooluse-guard.sh\" || exit 2",
            "timeout": 300
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/pretooluse-edit-guard.sh\" || exit 2",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
